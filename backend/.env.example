# Copiá este archivo como .env y completá los valores.
# El .env real nunca se commitea (está en .gitignore).

# ---------------------------------------------------------------------------
# Base de datos (obligatorio)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:password@localhost:5432/transformadores

# Solo si el proveedor usa un certificado propio que no valida contra las CA
# del sistema. Dejar sin definir en condiciones normales.
# DB_SSL_NO_VERIFY=false

# ---------------------------------------------------------------------------
# Sesión (obligatorio)
# ---------------------------------------------------------------------------
# Mínimo 32 caracteres: si falta o es más corto, el server NO arranca.
# Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=

# Duración de la sesión: 8h, 30m, 7d…
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000

# 'production' activa: HTTPS obligatorio, HSTS, CSP más estricta y CORS sin
# los orígenes de desarrollo.
NODE_ENV=development

# Orígenes autorizados para pedirle datos a la API desde otro dominio,
# separados por comas. En producción es obligatorio si el frontend no se
# sirve desde este mismo server.
#   CORS_ORIGIN=https://miempresa.com.ar,https://www.miempresa.com.ar
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Límites de peticiones
# ---------------------------------------------------------------------------
# Ventana en minutos y máximo de requests por ventana para /api.
# El login (10 por 15 min) y los cambios de contraseña (15 por 15 min) tienen
# sus propios límites, más estrictos, fijos en index.js.
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Archivos subidos
# ---------------------------------------------------------------------------
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
